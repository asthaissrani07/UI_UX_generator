# App URL (set to your Vercel URL in production, e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Clerk — https://dashboard.clerk.com
# Production: use pk_live_... and sk_live_... (NOT pk_test_/sk_test_ on Vercel)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Primary model (change when free limit hit):
#   qwen/qwen3-coder:free     — best for HTML/UI (recommended)
#   google/gemma-4-31b-it:free
#   meta-llama/llama-3.3-70b-instruct:free
#   openrouter/free           — auto-picks (shared limits, hits caps fast)
# Paid cheap testing (~$0.01–0.05/project): openai/gpt-4o-mini (needs $5 credits)
OPENROUTER_MODEL=qwen/qwen3-coder:free

# Optional: comma-separated fallbacks when primary is rate-limited (auto-rotates)
# OPENROUTER_MODEL_FALLBACKS=google/gemma-4-31b-it:free,meta-llama/llama-3.3-70b-instruct:free

# Optional: set to "true" to restore 2-project limit + paid-only features (Clerk plan "unlimited")
# ENABLE_BILLING_LIMITS=true
