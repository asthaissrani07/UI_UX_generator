# App URL (set to your Vercel URL in production, e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Clerk — https://dashboard.clerk.com
# Production: use pk_live_... and sk_live_... (NOT pk_test_/sk_test_ on Vercel)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Primary model — fast options for Vercel Hobby (10s limit):
#   meta-llama/llama-3.2-3b-instruct:free  — fastest (default)
#   openai/gpt-oss-20b:free
#   qwen/qwen3-coder:free                  — best HTML quality (slower)
# Paid cheap testing: openai/gpt-4o-mini (needs $5 credits)
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Optional: comma-separated fallbacks when primary is rate-limited (auto-rotates)
# OPENROUTER_MODEL_FALLBACKS=google/gemma-4-31b-it:free,meta-llama/llama-3.3-70b-instruct:free

# Optional: set to "true" to restore 2-project limit + paid-only features (Clerk plan "unlimited")
# ENABLE_BILLING_LIMITS=true
