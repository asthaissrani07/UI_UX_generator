# App URL (set to your Vercel URL in production, e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Clerk — https://dashboard.clerk.com
# Production: use pk_live_... and sk_live_... (NOT pk_test_/sk_test_ on Vercel)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenRouter — https://openrouter.ai/keys (optional if Gemini is set)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free

# Google Gemini — FREE separate quota (recommended when OpenRouter limit hit)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI provider: auto (OpenRouter → Gemini fallback) | openrouter | gemini
AI_PROVIDER=auto

# Optional: set to "true" to restore 2-project limit + paid-only features (Clerk plan "unlimited")
# ENABLE_BILLING_LIMITS=true
